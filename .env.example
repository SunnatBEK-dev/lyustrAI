AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Paid external smoke tests remain disabled until explicitly set to 1.
RUN_ANTHROPIC_INTEGRATION=0
RUN_OPENAI_INTEGRATION=0
RUN_GEMINI_INTEGRATION=0
MAX_TOKENS=1024
TIMEOUT=60
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_DELAY=0.25
LLM_RETRY_MAX_DELAY=2.0
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3
CONTEXT_TOKEN_BUDGET=3000
CONTEXT_SUMMARY_TOKEN_BUDGET=400
MEMORY_RETRIEVAL_K=3
WEB_HOST=127.0.0.1
WEB_PORT=8000
UPLOAD_MAX_BYTES=10485760
